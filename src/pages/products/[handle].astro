---
// Product page — statically generated for every piece: two campaign shots,
// colour swatches, size buttons wired to the shared quick-view/add flow,
// accordion details and companion pieces from the same category.
import Layout from '../../layouts/Layout.astro';
import { commerce } from '../../lib/commerce';

export async function getStaticPaths() {
  const products = await commerce.listProducts();
  return products.map((p) => ({ params: { handle: p.handle }, props: { product: p } }));
}

const { product } = Astro.props;
const p = product as any;
const meta = p.meta ?? {};
const fmt = (n: number) => '€' + n.toFixed(2);
const sale = !!p.compareAtPrice;

const related = (await commerce.listProducts())
  .filter((r) => (r as any).meta?.cat === meta.cat && r.handle !== p.handle)
  .slice(0, 4) as any[];

const productLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: p.title,
  description: p.description,
  image: new URL(p.images[0]?.src ?? '', Astro.site).href,
  brand: { '@type': 'Brand', name: 'Noble Muse' },
  offers: {
    '@type': 'Offer',
    price: p.price.amount,
    priceCurrency: 'EUR',
    availability: 'https://schema.org/InStock',
  },
});

const ACCS = [
  ['Fabric & care', 'Main fabric 68% virgin wool, 32% recycled polyamide. Dry clean only. Store folded to hold the shape.'],
  ['Fit & measurements', 'Regular fit with a slightly dropped shoulder. Model is 178 cm and wears size S. Length 96 cm in size S.'],
  ['Delivery & returns', 'Free delivery on orders above €150. Returns free within 30 days.'],
];
---

<Layout title={`${p.title} — NOBLE MUSE`} description={p.description} ogImage={p.images[0]?.src}>
  <script type="application/ld+json" set:html={productLd} />

  <main class="mx-auto max-w-[1640px] px-4 pt-[132px] sm:px-5 sm:pt-[130px] lg:px-9">
    <div class="cap-xs mb-8 text-muted">
      <a href="/">HOME</a> / <a href={`/catalog?cat=${encodeURIComponent(meta.cat)}`}>{meta.cat.toUpperCase()}</a> / {p.title.toUpperCase()}
    </div>

    <article class="grid gap-10 lg:grid-cols-2 lg:gap-16">
      <div class="grid gap-0.5 bg-tint sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
        <img src={p.images[0]?.src} alt={p.title} class="aspect-[3/4] w-full object-cover" />
        {p.images[1] && <img src={p.images[1].src} alt={p.images[1].alt} class="aspect-[3/4] w-full object-cover" />}
      </div>

      <div class="flex max-w-[560px] flex-col gap-6">
        <div class="flex flex-col gap-3">
          {meta.badge && (
            <span class="cap-xs w-fit px-2.5 py-1.5 text-white" style={`background:${meta.badge === 'LAST CHANCE' ? '#6f5bd6' : '#191936'}`}>{meta.badge}</span>
          )}
          <div class="cap-xs text-muted">{meta.cat.toUpperCase()}</div>
          <h1 class="m-0 text-[24px] font-normal tracking-[0.16em]">{p.title.toUpperCase()}</h1>
          <div class="text-[15px] tracking-[0.05em]">
            {sale
              ? <><span class="text-acc">{fmt(p.price.amount)}</span> <span class="text-muted line-through">· was {fmt(p.compareAtPrice.amount)}</span></>
              : fmt(p.price.amount)}
          </div>
        </div>

        <div class="flex flex-col gap-3" data-pdp data-handle={p.handle}>
          <div class="cap-xs text-muted">COLOUR — <span data-pdp-color-name>{meta.colors[0]?.name}</span></div>
          <div class="flex gap-2">
            {meta.colors.map((c: any, i: number) => (
              <button data-pdp-color={i} data-name={c.name} class={'h-[18px] w-[18px] cursor-pointer border ' + (i === 0 ? 'border-ink' : 'border-line')} style={`background:${c.hex}`}></button>
            ))}
          </div>
          <div class="cap-xs mt-2 text-muted">SIZE</div>
          <div class="flex flex-wrap gap-2">
            {meta.sizes.map((z: string, i: number) => (
              <button data-pdp-size={z} class="cap cursor-pointer border border-line px-4 py-2.5 transition [&.on]:border-ink [&.on]:bg-ink [&.on]:text-white" style="letter-spacing:.14em">{z}{i === 3 ? ' — 2 left' : ''}</button>
            ))}
          </div>
          <div class="text-[10px] tracking-[0.08em] text-muted">Model is 178 cm and wears size S</div>
          <button data-pdp-add class="btn-ink is-off mt-2 p-4">Select a size</button>
          <div class="cap-xs text-muted">Free delivery over €150 · Free returns within 30 days</div>
        </div>

        <div class="border-t border-line">
          {ACCS.map(([t, body], i) => (
            <details class="group border-b border-line" open={i === 0}>
              <summary class="cap flex cursor-pointer list-none items-center justify-between py-4" style="letter-spacing:.18em">
                <span>{t}</span><span class="group-open:hidden">+</span><span class="hidden group-open:inline">−</span>
              </summary>
              <div class="pb-5 text-[12px] leading-loose text-soft">{body}</div>
            </details>
          ))}
        </div>
      </div>
    </article>

    {related.length > 0 && (
      <section class="pt-28">
        <div class="mb-8 flex items-end justify-between">
          <h2 class="m-0 text-[15px] font-normal tracking-[0.26em]">MORE {meta.cat.toUpperCase()}</h2>
          <a href={`/catalog?cat=${encodeURIComponent(meta.cat)}`} class="cap link-u" style="letter-spacing:.2em">View all</a>
        </div>
        <div data-related class="grid grid-cols-2 gap-4 lg:grid-cols-4"></div>
      </section>
    )}
  </main>

  <script>
    import { addToCart, wishlist } from '../../lib/stores';
    import { cardHTML } from '../../lib/card';

    const $ = <T extends HTMLElement = HTMLElement>(s: string) => document.querySelector(s) as T | null;
    const DATA = JSON.parse(document.body.dataset.muse!);
    const handle = ($('[data-pdp]') as HTMLElement).dataset.handle!;
    const p = DATA.products.find((x: any) => x.handle === handle);

    let color = 0, size = '';
    document.querySelectorAll<HTMLElement>('[data-pdp-color]').forEach((b) =>
      b.addEventListener('click', () => {
        color = Number(b.dataset.pdpColor);
        $('[data-pdp-color-name]')!.textContent = b.dataset.name!;
        document.querySelectorAll<HTMLElement>('[data-pdp-color]').forEach((x) => {
          x.classList.toggle('border-ink', x === b);
          x.classList.toggle('border-line', x !== b);
        });
      })
    );
    const addBtn = $('[data-pdp-add]') as HTMLButtonElement;
    document.querySelectorAll<HTMLElement>('[data-pdp-size]').forEach((b) =>
      b.addEventListener('click', () => {
        size = b.dataset.pdpSize!;
        document.querySelectorAll<HTMLElement>('[data-pdp-size]').forEach((x) => x.classList.toggle('on', x === b));
        addBtn.classList.remove('is-off');
        addBtn.textContent = 'Add to bag — ' + size;
      })
    );
    addBtn?.addEventListener('click', () => {
      if (!size || !p) return;
      addToCart(p.handle, size, p.colors[color]?.name ?? '');
      document.querySelector<HTMLElement>('[data-open-cart]')?.click();
    });

    // related cards via the shared renderer
    const relatedEl = $('[data-related]');
    if (relatedEl && p) {
      const rel = DATA.products.filter((r: any) => r.cat === p.cat && r.handle !== p.handle).slice(0, 4);
      relatedEl.innerHTML = rel.map((r: any) => cardHTML(r, wishlist.get().includes(r.handle))).join('');
    }
  </script>
</Layout>
